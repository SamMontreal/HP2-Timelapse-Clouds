+// Screen-space particle vertices are already available on the CPU. Estimate their
+// fill cost and limit the composite to the part of the player view they cover.
+static bool smoke_bounds(const NativeFrame &frame, size_t first, size_t last, VkRect2D &rect)
+{
+    if (g_between) return false;
+    const NativeDraw &lead = frame.draws[first];
+    float ox, sx, sy;
+    active_region(frame,ox,sx,sy);
+    float left = ox+lead.view[0]*sx, top = lead.view[1]*sy;
+    float width = lead.view[2]*sx, height = lead.view[3]*sy;
+    const bool mirror = lead.target == 7;
+    const int target_w = mirror ? g.rvm_w : W, target_h = mirror ? g.rvm_h : H;
+    if (mirror) { left=top=0; width=float(target_w); height=float(target_h); }
+    float min_x=1.f, min_y=1.f, max_x=-1.f, max_y=-1.f, area=0.f;
+    for (size_t i=first;i<last;++i) {
+        const NativeDraw &d=frame.draws[i];
+        if (d.indexed || d.ranges || size_t(d.first)+d.count>frame.vertices.size() || d.count%6) return false;
+        for (uint32_t j=0;j<d.count;j+=6) {
+            float x0=1.f,y0=1.f,x1=-1.f,y1=-1.f;
+            for (int k=0;k<6;++k) {
+                const auto &v=frame.vertices[d.first+j+k];
+                const float *m=d.clip;
+                float w=m[3]*v.x+m[7]*v.y+m[11]*v.z+m[15];
+                if (!(w>0.f)) return false;
+                float x=std::clamp((m[0]*v.x+m[4]*v.y+m[8]*v.z+m[12])/w,-1.f,1.f);
+                float y=std::clamp((m[1]*v.x+m[5]*v.y+m[9]*v.z+m[13])/w,-1.f,1.f);
+                x0=std::min(x,x0); x1=std::max(x,x1);
+                y0=std::min(y,y0); y1=std::max(y,y1);
+            }
+            min_x=std::min(min_x,x0); min_y=std::min(min_y,y0);
+            max_x=std::max(max_x,x1); max_y=std::max(max_y,y1);
+            area+=(x1-x0)*(y1-y0);
+        }
+    }
+    if (area*width*height*.25f < (mirror ? 250000.f : 1500000.f)) return false;
+    int x0=std::clamp(int(floorf(left+(min_x+1.f)*width*.5f))-4,std::clamp(int(left),0,target_w),target_w);
+    int y0=std::clamp(int(floorf(top+(min_y+1.f)*height*.5f))-4,std::clamp(int(top),0,target_h),target_h);
+    int x1=std::clamp(int(ceilf(left+(max_x+1.f)*width*.5f))+4,x0,std::clamp(int(ceilf(left+width)),x0,target_w));
+    int y1=std::clamp(int(ceilf(top+(max_y+1.f)*height*.5f))+4,y0,std::clamp(int(ceilf(top+height)),y0,target_h));
+    rect={{x0,y0},{uint32_t(x1-x0),uint32_t(y1-y0)}};
+    return rect.extent.width && rect.extent.height;
+}
