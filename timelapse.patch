+#version 450
+layout(set=0,binding=0) uniform sampler2D smoke;
+layout(set=1,binding=0) uniform sampler2D lastAlpha;
+layout(set=2,binding=0) uniform sampler2D sceneDepth;
+layout(location=0,index=0) out vec4 src;
+layout(location=0,index=1) out vec4 factors;
+
+void main() {
+    ivec2 full = textureSize(sceneDepth,0), small = (full+3)/4;
+    vec2 p = gl_FragCoord.xy * vec2(small)/vec2(full) - .5;
+    ivec2 start = ivec2(floor(p));
+    vec2 f = fract(p);
+    float z = texelFetch(sceneDepth,ivec2(gl_FragCoord.xy),0).r;
+    // On a smooth surface the fixed-function bilinear filter can reconstruct both
+    // attachments directly. At a silhouette, check the four source depths below.
+    vec2 centre = clamp(p+.5,vec2(.5),vec2(small)-.5);
+    vec2 uv = centre/vec2(textureSize(smoke,0));
+    vec2 last = textureLod(lastAlpha,uv,0.).rg;
+    float depthSlope = fwidth(z);
+    if (last.g==0.) discard;
+    ivec2 nearPixel = min(ivec2((floor(centre)+.5)*vec2(full)/vec2(small)),full-1);
+    float nearZ = texelFetch(sceneDepth,nearPixel,0).r;
+    float tolerance = max(z*.005,1.e-7);
+    if (abs(z-nearZ)<tolerance && depthSlope<tolerance*.2) {
+        vec4 filtered = textureLod(smoke,uv,0.);
+        src = vec4(filtered.rgb,last.r);
+        factors = vec4(vec3(clamp(filtered.a,0.,1.)),last.g);
+        return;
+    }
+    vec4 colour = vec4(0.);
+    vec2 alpha = vec2(0.);
+    float total = 0.;
+    for (int y=0;y<2;y++) for (int x=0;x<2;x++) {
+        ivec2 k = clamp(start+ivec2(x,y),ivec2(0),small-1);
+        ivec2 at = min(ivec2((vec2(k)+.5)*vec2(full)/vec2(small)),full-1);
+        float sampleZ = texelFetch(sceneDepth,at,0).r;
+        // Across a car silhouette, trust samples from the same depth surface.
+        float error = abs(z-sampleZ)/max(max(z,sampleZ)*.02,1.e-7);
+        float weight = (x==0 ? 1.-f.x : f.x)*(y==0 ? 1.-f.y : f.y)/(1.+16.*error*error);
