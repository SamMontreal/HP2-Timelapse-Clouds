+// A low elevation occupies more rows so distant cloud outlines survive filtering.
+const float skyTau = 6.28318530718;
+const float lowestElevation = -.045;
+const float elevationSpan = 1.57079632679 - lowestElevation;
+// Compress the grid's angular spacing around the primary camera. The opposite
+// hemisphere remains continuous across the wrap and feeds the mirror/reflections.
+const float forwardSpacing = .55;
+vec3 panoramaRay(vec2 uv, float focus) {
+    float halfAngle = .5*skyTau*(uv.x-.5);
+    float az = focus+2.*atan(forwardSpacing*sin(halfAngle),cos(halfAngle));
+    float el = lowestElevation + elevationSpan*uv.y*(.40+.60*uv.y);
+    return vec3(cos(el)*cos(az),sin(el),cos(el)*sin(az));
+}
+vec2 panoramaUV(vec3 r, float focus) {
+    float e = clamp((asin(clamp(r.y,-1.,1.))-lowestElevation)/elevationSpan,0.,1.);
+    float row = (2.*e)/(.4+sqrt(.16+2.4*e));
+    float az = dot(r.xz,r.xz)>1.e-12 ? atan(r.z,r.x) : focus;
+    float halfAngle = .5*(az-focus);
+    float u = .5+2.*atan(sin(halfAngle),forwardSpacing*cos(halfAngle))/skyTau;
+    return vec2(u,row);
+}
