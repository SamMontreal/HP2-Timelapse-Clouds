+        alpha += texelFetch(lastAlpha,k,0).rg*weight;
+        total += weight;
+    }
+    colour /= max(total,1.e-15);
+    alpha /= max(total,1.e-15);
+    src = vec4(colour.rgb,alpha.r);
+    factors = vec4(vec3(clamp(colour.a,0.,1.)),alpha.g);
