+static unsigned cloudSunForView(const NativeFrame &frame, unsigned view, bool report)
+{
+    const NativeDraw *sky=nullptr, *disk=nullptr;
+    for(const auto &draw:frame.draws) {
+        if(draw.target!=view || !draw.count) continue;
+        if(!sky && draw.cloud_profile && draw.snap_x!=0) sky=&draw;
+        if(draw.tex && !draw.indexed && !draw.ranges && draw.count==6 &&
+           size_t(draw.first)+6<=frame.vertices.size() && !strcmp(draw.tex->name,"SUNCENTER")) disk=&draw;
+    }
+    if(!sky || !disk || sky->view[2]<=0 || sky->view[3]<=0) return 0;
+    double low[2]={1e12,1e12},high[2]={-1e12,-1e12};
+    float diskClip[16], skyClip[16];
+    picture_clip(diskClip, *disk);
+    picture_clip(skyClip, *sky);
+    for(unsigned j=0;j<6;j++) {
+        const auto &v=frame.vertices[disk->first+j];
+        const auto &m=diskClip;
+        double w=m[3]*v.x+m[7]*v.y+m[11]*v.z+m[15];
+        if(w<=0) return 0;
+        for(int i=0;i<2;i++) {
+            double ndc=(m[i]*v.x+m[4+i]*v.y+m[8+i]*v.z+m[12+i])/w;
+            double pixel=disk->view[i]+(ndc+1)*.5*disk->view[i+2];
+            low[i]=std::min(low[i],pixel);high[i]=std::max(high[i],pixel);
+        }
+    }
+    double ndc[2];
+    for(int i=0;i<2;i++) ndc[i]=(low[i]+high[i]-2.*sky->view[i])/sky->view[i+2]-1.;
+    double a[3],b[3],dir[3];
+    const auto &m=skyClip;
+    for(int k=0;k<3;k++) {
+        a[k]=m[4*k]-ndc[0]*m[4*k+3]; b[k]=m[4*k+1]-ndc[1]*m[4*k+3];
+    }
+    for(int k=0;k<3;k++) dir[k]=a[(k+1)%3]*b[(k+2)%3]-a[(k+2)%3]*b[(k+1)%3];
+    double n=std::sqrt(dir[0]*dir[0]+dir[1]*dir[1]+dir[2]*dir[2]);
+    double forward=dir[0]*m[3]+dir[1]*m[7]+dir[2]*m[11];
+    if(n<1e-18 || std::abs(forward)<1e-22) return 0;
+    for(double &v:dir) v*=forward>0?1/n:-1/n;
