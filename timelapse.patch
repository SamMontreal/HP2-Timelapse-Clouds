+// Coordinates on a plane normal to sunlight. Transmittance stays constant
+// along a parallel light ray in the clear air below the cloud shell.
+const float lightExtent = 16.;
+vec3 sunSide(vec3 sun) {
+    return dot(sun.xz,sun.xz)>.00001 ? normalize(vec3(-sun.z,0.,sun.x)) : vec3(0.,0.,1.);
+}
+vec2 lightMapUV(vec2 q) {
+    vec2 x = abs(q)/lightExtent;
+    return .5 + .5*sign(q)*(2.*x)/(.30+sqrt(.09+2.8*x));
+}
+vec2 lightMapWorld(vec2 uv) {
+    vec2 s=2.*uv-1.;
+    return lightExtent*s*(.30+.70*abs(s));
+}
+float solarColumn(vec2 q, vec3 sun, RegionCloud c, int region) {
+    vec3 side=sunSide(sun);
+    vec3 origin=q.x*side + q.y*cross(side,sun);
+    vec3 radial=origin+vec3(0.,200.,0.);
+    float b=dot(radial,sun);
+    float base=200.+c.shape.x, top=base+c.shape.y;
+    float inner=b*b+base*base-dot(radial,radial);
+    if (inner<=0.) return 1.;
+    float a=-b+sqrt(inner);
+    float z=-b+sqrt(inner+c.shape.y*(top+base));
+    vec3 middle=origin+sun*(.5*(a+z));
+    float range=length(middle);
+    if (range>=65.) return 1.;
+    float cover=weatherAt(middle/max(range,.001),region,c);
+    bool towers=cumulus(region);
+    if (!towers && cover<=.016) return 1.;
+    Volume volume=cloudVolume(region,c,cover);
+    float extinction=c.optical.y*(towers?1.44:1.12);
+    int n=clamp(int(ceil((z-a)/.145)),12,64);
+    float stepSize=(z-a)/float(n),depth=0.;
+    for (int i=0;i<n;i++) {
+        vec3 p=origin+sun*(a+(float(i)+.5)*stepSize);
+        if (towers) {
+            int empty=int(floor(towerClearance(p,volume)/stepSize));
+            if (empty>0) { i+=empty-1; continue; }
+        }
+        depth+=cloudDensity(p,volume,heightAt(p,volume),true,region)*stepSize;
+        if (depth*extinction>7.) break;
+    }
+    return mix(exp(-depth*extinction),1.,smoothstep(53.,65.,range));
+}
+
+#ifndef BUILD_SOLAR_COLUMNS
+float sunlightAt(vec2 q, vec3 sun, RegionCloud c, int region) {
+#ifdef CACHED_SOLAR_COLUMNS
+    return textureLod(sunColumns,lightMapUV(q),0.).r;
+#else
+    return solarColumn(q,sun,c,region);
+#endif
+}
+// Single scattering in the band of air directly underneath the cloud base.
+// A neighbourhood of parallel columns supplies the surrounding shadow level:
+// uniform blue sky or a uniformly opaque bank produces no shaft contrast.
+vec3 cloudShafts(vec3 rd, vec3 sun, RegionCloud c, int region, float airEnd, float front, float back, float finalTrans) {
+    float facing=dot(rd,sun);
+    float phase=smoothstep(.74,.98,facing)*smoothstep(.015,.125,sun.y);
+    phase*=smoothstep(-.024,.042,rd.y);
+    if (phase<=.00015) return vec3(0.);
+    float a=shellExit(rd,200.+c.shape.x*.29);
+    float b=min(airEnd,41.);
+    if (a>=b) return vec3(0.);
+    vec3 side=sunSide(sun);
+    vec2 direction=vec2(dot(rd,side),dot(rd,cross(side,sun)));
+    float spread=.52+.23*c.shape.y;
+#ifdef CACHED_SOLAR_COLUMNS
+    const int slices=16;
+#else
+    const int slices=6;
+#endif
+    float path=b-a, sum=0.;
+    for (int i=0;i<slices;i++) {
+        float f=(float(i)+.5)/float(slices);
+        float distance=a+path*f;
+        float viewTrans=mix(1.,finalTrans,smoothstep(front,max(front+.04,back),distance));
+        if (viewTrans<.012) break;
+        vec2 q=direction*distance;
+        float window=1.-smoothstep(.82*lightExtent,lightExtent-spread,max(abs(q.x),abs(q.y)));
+        if (window<=0.) continue;
