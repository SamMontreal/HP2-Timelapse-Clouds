+case 0x28f2c148u: case 0xc279d506u: return 7;
+case 0x0ca81f04u: case 0x0fdfe5eeu: return 8;
+case 0x5ad8ff3cu: case 0x0b24f42au: return 9;
+case 0x1ede2a5eu: case 0x063efb98u: return 10;
