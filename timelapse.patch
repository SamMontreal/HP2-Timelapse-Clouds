+static bool layer_smoke(const NativeDraw &d)
+{
+    return (d.target == 1 || d.target == 2 || d.target == 7) && d.tex && d.rt < 0 &&
+           d.snap_x == 0 && !d.flags && !d.depth_write && !d.alpha_test && d.blend == NB_ALPHA &&
