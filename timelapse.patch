+#ifdef CACHED_SOLAR_COLUMNS
+        float around=.25*(sunlightAt(q+vec2(spread,0.),sun,c,region)+sunlightAt(q-vec2(spread,0.),sun,c,region)
+                         +sunlightAt(q+vec2(0.,spread),sun,c,region)+sunlightAt(q-vec2(0.,spread),sun,c,region));
+#else
+        vec2 offset=(i%2==0?vec2(spread,0.):vec2(0.,spread));
+        float around=.5*(sunlightAt(q+offset,sun,c,region)+sunlightAt(q-offset,sun,c,region));
+#endif
+        // Only locally open columns bordering an actual cloud shadow form a
+        // bright streak. Its cross section changes as the occluding billows roll.
+        float opening=smoothstep(.01,.50,lit-around);
+        sum+=window*viewTrans*lit*opening*(.66+.68*f);
+    }
+    float depth=1.-exp(-.58*path);
+    vec3 lightColour=mix(c.lit,vec3(1.,.86,.63),daylight(region)?.38:.14);
+    if (sunset(region)) {
+        float warm=1.-smoothstep(.14,.64,sun.y);
+        lightColour=mix(lightColour,vec3(1.,.68,.32),warm);
+    }
+    return lightColour*(.78*phase*depth*sum/float(slices));
+}
