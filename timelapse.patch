+static void draw_scene_range(const NativeFrame &frame, size_t first, size_t last, const VkRenderPassBeginInfo &scene, bool mirror = false)
+{
+    const int target = mirror ? 7 : 1, width = mirror ? g.rvm_w : W, height = mirror ? g.rvm_h : H;
+    auto belongs = [mirror](const NativeDraw &draw) { return mirror ? draw.target == 7 : draw.target == 1 || draw.target == 2; };
+    const VkImage depth = mirror ? g.rvm_depth : g.depth;
+    if (!g.smoke_layer || g_ab == 1) {
+        draw_target(frame,target,width,height, first, last);
+        return;
+    }
+    size_t pending = first;
+    for (size_t i = first; i < last;) {
+        const NativeDraw &d = frame.draws[i];
+        if (!d.count || !belongs(d) || !layer_smoke(d)) { ++i; continue; }
+        const size_t start = i;
+        size_t vertices = 0;
+        do {
+            vertices += frame.draws[i].count;
+            ++i;
+        } while (i < last && layer_smoke(frame.draws[i]) && frame.draws[i].target == d.target && frame.draws[i].depth_test == d.depth_test &&
+                 !memcmp(d.view,frame.draws[i].view,sizeof d.view));
+        // Small wisps cost less in the original main pass than a composite.
+        VkRect2D scissor;
+        if (vertices < 72 || !smoke_bounds(frame,start,i,scissor)) continue;
+        if (!mirror && vertices >= 720) g.dense_smoke = true;
+        draw_target(frame,target,width,height, pending, start);
+        vkCmdEndRenderPass(g.cmd);
+        depth_image_barrier(depth,VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+        VkClearValue clear[2] = {};
+        VkRenderPassBeginInfo pass = {VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+        pass.renderPass = g.smoke_pass;
+        pass.framebuffer = g.smoke_fb;
+        pass.renderArea.extent = {uint32_t((width+3)/4), uint32_t((height+3)/4)};
+        pass.clearValueCount = 2;
+        pass.pClearValues = clear;
+        vkCmdBeginRenderPass(g.cmd, &pass, VK_SUBPASS_CONTENTS_INLINE);
+        draw_target(frame,target,(width+3)/4,(height+3)/4,start,i,true);
+        vkCmdEndRenderPass(g.cmd);
+        all_barrier();
+
+        pass.renderPass = mirror ? g.rvm_post_pass : g.post_pass;
+        pass.framebuffer = mirror ? g.rvm_post_fb : g.post_fb;
+        pass.renderArea.extent = {uint32_t(width), uint32_t(height)};
+        pass.clearValueCount = 0;
+        vkCmdBeginRenderPass(g.cmd, &pass, VK_SUBPASS_CONTENTS_INLINE);
+        const VkViewport viewport = {0, 0, float(width), float(height), 0, 1};
+        vkCmdSetViewport(g.cmd, 0, 1, &viewport);
+        vkCmdSetScissor(g.cmd, 0, 1, &scissor);
+        vkCmdBindPipeline(g.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, g.smoke_composite);
+        const VkDescriptorSet inputs[] = {g.smoke_sets[0],g.smoke_sets[1],mirror ? g.smoke_mirror_depth : g.smoke_sets[2]};
+        vkCmdBindDescriptorSets(g.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, g.smoke_layout, 0, 3, inputs, 0, nullptr);
+        vkCmdDraw(g.cmd, 3, 1, 0, 0);
+        vkCmdEndRenderPass(g.cmd);
+        depth_image_barrier(depth,VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
+        all_barrier();
+        auto resume = scene;
+        resume.renderPass = mirror ? g.env_pass_load : g.pass_load;
+        vkCmdBeginRenderPass(g.cmd, &resume, VK_SUBPASS_CONTENTS_INLINE);
+        pending = i;
+    }
+    draw_target(frame,target,width,height, pending, last);
+}
